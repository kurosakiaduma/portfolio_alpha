# Azure Deployment Environment Configuration
# Copy this file to .env and fill in with actual values

# ===== Port Configuration =====
# Frontend service port (exposed on host)
FRONTEND_PORT=3000

# Backend service port (exposed on host)
BACKEND_PORT=8000

# ===== MongoDB Configuration =====
# Connection URI for MongoDB (e.g., Azure Cosmos DB or Atlas)
MONGO_URI=mongodb+srv://username:password@host/database?retryWrites=true&w=majority

# MongoDB database name
MONGO_DB=portfolio

# ===== JWT & Security =====
# Secret key for JWT token signing (use strong random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ===== Frontend Configuration =====
# Public site URL for CORS
PUBLIC_SITE_URL=https://your-domain.com

# Backend API URL (exposed to frontend)
PUBLIC_API_URL=https://api.your-domain.com

# Ollama and backend LLM configuration
OLLAMA_BASE=http://ollama:11434
MODEL=mistral:7b-instruct
ADMIN_TOKEN=your-admin-token
ALLOWED_ORIGINS=https://your-domain.com,http://localhost:3000

# ===== Backend MCP Configuration (Optional) =====
# MCP_MODEL=llama2
# MCP_TEMPERATURE=0.7
# MCP_MAX_TOKENS=2048
# MCP_LLM_PROVIDER=ollama
# MCP_OLLA_HOST=localhost
# MCP_OLLA_MODEL=llama2

# ===== Email Configuration (Optional) =====
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# CONTACT_EMAIL=contact@your-domain.com

# ===== Social Media Integration (Optional) =====
# GITHUB_TOKEN=ghp_xxxxxxxxxxxx
# PINTEREST_ACCESS_TOKEN=xxxxxxxxxxxx
# INSTAGRAM_ACCESS_TOKEN=xxxxxxxxxxxx
# SOUNDCLOUD_CLIENT_ID=xxxxxxxxxxxx
# SOUNDCLOUD_USER_ID=xxxxxxxxxxxx
