---
// Check authentication at build time (server-side)
const token = Astro.cookies.get('admin_token')?.value;

if (!token) {
  return Astro.redirect('/alter/login');
}

import AdminLayout from '../../layouts/Layout.astro';
import AdminApp from '../../components/admin/AdminApp';
---

<AdminLayout title="Portfolio Admin — Alter">
  <!-- React router SPA container -->
  <AdminApp client:only="react" />
</AdminLayout>
